{
  "module":{
    "name":"entry","type":"entry","mainElement":"EntryAbility",
    "deviceTypes":["phone","tablet"],"deliveryWithInstall":true,"installationFree":false,
    "pages":"$profile:main_pages",
    "requestPermissions":[{"name":"ohos.permission.INTERNET"}],
    "abilities":[{
      "name":"EntryAbility","srcEntry":"./ets/entryability/EntryAbility.ets",
      "icon":"$media:app_icon","label":"$string:app_name","description":"$string:app_description",
      "startWindowIcon":"$media:app_icon","startWindowBackground":"$color:start_background",
      "exported":true,
      "skills":[{"entities":["entity.system.home"],"actions":["ohos.want.action.home"]}]
    }]
  }
}
